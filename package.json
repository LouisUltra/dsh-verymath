{
  "name": "@louisultra/dsh-verymath",
  "version": "0.5.0",
  "description": "VeryMath capabilities for DSH: 16 bundled math skills and 14 tools covering paper reading, bilingual glossary, writing, Beamer, optimization, computation, Lean formalization, research workflows, Sage doc lookup and MATLAB. Community plugin for issue ECNU/EduWork#152.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core/index.js",
    "./tool": "./lib/tool/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "skills/**/*",
    "!**/__pycache__",
    "!**/*.pyc",
    "docs/capability-examples.md",
    "docs/examples/**",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "NOTICE.md",
    "UPSTREAM.json",
    "CHANGELOG.md",
    "!**/tests",
    "!**/test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:runtime": "node scripts/probe-runtime.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:runtime",
    "test:upstream": "python3 -m unittest discover -s ../../research/AI4Math-MathTool/skills/math-glossary/tests"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.2.0",
    "@deepseek-ai/dsh-fs": ">=0.2.1-rc.5 <0.3.0-0 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5 <0.3.0-0 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.5 <0.3.0-0 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0-0 || 0.2.2-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.5 <3.19.0 || 3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "verymath",
    "mathematics",
    "glossary",
    "paper-reading",
    "eduwork"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LouisUltra/dsh-verymath.git"
  },
  "homepage": "https://github.com/LouisUltra/dsh-verymath#readme",
  "bugs": {
    "url": "https://github.com/LouisUltra/dsh-verymath/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.3.2"
  }
}
